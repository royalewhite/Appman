#!/data/data/com.termux/files/usr/bin/sh

# Appman — Android package manager for Termux + root
# Dynamic Android profile discovery.
# Default: Android user 0, third-party applications.

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SELF="$SCRIPT_DIR/appman"
PREVIEW="$SCRIPT_DIR/appman-preview"
PROFILE_HELPER="$SCRIPT_DIR/appman-profiles"

STATE_FILE="$HOME/.appman.view.$$"
PROFILE_FILE="$HOME/.appman.profiles.$$"
TAB_MAP="$HOME/.appman.tabs.$$"
SHORTCUT_FILE="$HOME/.appman.shortcuts.$$"

USER_ID=0
FILTER=user

cleanup() {
  rm -f "$STATE_FILE" "$PROFILE_FILE" "$TAB_MAP" "$SHORTCUT_FILE"
}
trap cleanup 0 1 2 15

# --------------------------------------------------
# PROFILE DISCOVERY
# --------------------------------------------------

if [ ! -x "$PROFILE_HELPER" ]; then
  printf 'Appman: profile helper is missing or not executable.\n'
  exit 1
fi

if ! "$PROFILE_HELPER" > "$PROFILE_FILE" || [ ! -s "$PROFILE_FILE" ]; then
  printf 'Appman: Android profile discovery failed.\n'
  exit 1
fi

if ! grep -q '^0[[:space:]]' "$PROFILE_FILE"; then
  printf 'Appman: Android user 0 was not discovered. Refusing to start.\n'
  exit 1
fi

# --------------------------------------------------
# DYNAMIC TAB AND SHORTCUT GENERATION
# --------------------------------------------------

HEADER=''
EXPECT_KEYS='enter,ctrl-f,ctrl-t,alt-u,alt-y'
PROFILE_COUNT=0

: > "$TAB_MAP"
: > "$SHORTCUT_FILE"

add_tab() {
  tab_kind=$1
  tab_value=$2
  tab_label=$3

  [ -n "$HEADER" ] && HEADER="$HEADER "

  tab_start=$((${#HEADER} + 1))
  HEADER="${HEADER}[$tab_label]"
  tab_end=${#HEADER}

  printf '%s %s %s %s\n' \
    "$tab_start" "$tab_end" "$tab_kind" "$tab_value" >> "$TAB_MAP"
}

while IFS="$(printf '\t')" read -r id label type name; do
  case "$id" in
    ''|*[!0-9]*) continue ;;
  esac

  PROFILE_COUNT=$((PROFILE_COUNT + 1))
  add_tab profile "$id" "$label"

  if [ "$PROFILE_COUNT" -le 9 ]; then
    shortcut="alt-$PROFILE_COUNT"
    EXPECT_KEYS="$EXPECT_KEYS,$shortcut"
    printf '%s\t%s\n' "$shortcut" "$id" >> "$SHORTCUT_FILE"
  fi
done < "$PROFILE_FILE"

add_tab filter user USER
add_tab filter system SYSTEM

if [ "$PROFILE_COUNT" -eq 0 ]; then
  printf 'Appman: no usable Android profiles found.\n'
  exit 1
fi

# --------------------------------------------------
# PACKAGE LISTING
# --------------------------------------------------

list_packages() {
  case "$2" in
    user) flag=-3 ;;
    system) flag=-s ;;
    *) return 2 ;;
  esac

  sudo cmd package list packages --user "$1" "$flag" 2>/dev/null |
    sed 's/^package://' | sort -f
}

get_profile_name() {
  awk -F '\t' -v id="$USER_ID" \
    '$1 == id { print $4; exit }' "$PROFILE_FILE"
}

get_profile_label() {
  awk -F '\t' -v id="$USER_ID" \
    '$1 == id { print $2; exit }' "$PROFILE_FILE"
}

# --------------------------------------------------
# HELP
# --------------------------------------------------

show_help() {
  clear
  printf '%s\n' '╭────────────────────── APPMAN HELP ──────────────────────╮'
  printf '%s\n' '│ PROFILE NAVIGATION                                       │'

  index=0
  while IFS="$(printf '\t')" read -r id label type name; do
    case "$id" in
      ''|*[!0-9]*) continue ;;
    esac

    index=$((index + 1))
    if [ "$index" -le 9 ]; then
      printf '│   ALT-%s / [%s]  %s (ID %s)\n' \
        "$index" "$label" "$name" "$id"
    else
      printf '│   [%s]  %s (ID %s)\n' "$label" "$name" "$id"
    fi
  done < "$PROFILE_FILE"

  cat <<'HELP'
│                                                            │
│ APP FILTERS                                                 │
│   ALT-U        User-installed apps                          │
│   ALT-Y        System apps                                   │
│                                                            │
│ NAVIGATION                                                   │
│   UP / DOWN    Navigate                                      │
│   SPACE        Select / deselect                             │
│   U            Clear selections                              │
│   ENTER        Uninstall selected / current app              │
│                                                            │
│ ACTIONS                                                      │
│   CTRL-F       Freeze selected apps                         │
│   CTRL-T       Enable selected apps                         │
│   CTRL-R       Toggle search                                │
│   ESC          Clear search                                 │
│   ?            Show help                                    │
│   CTRL-Q       Quit                                         │
│               Disabled / frozen indicator                  │
│                                                            │
│ SAFETY                                                       │
│   No select-all shortcut exists.                            │
│   Profile changes clear selections.                         │
│   Actions target only the active Android user.              │
╰────────────────────────────────────────────────────────────╯
HELP

  printf '\nPress ENTER to return to Appman...'
  read -r _ </dev/tty
}

# --------------------------------------------------
# PACKAGE ACTIONS
# --------------------------------------------------

run_action() {
  action=$1
  target_user=$2
  selected=$3

  [ -n "$selected" ] || {
    printf '\033[1;33mNo applications selected.\033[0m\n'
    printf '\nPress ENTER to return...'
    read -r _ </dev/tty
    return
  }

  case "$action" in
    freeze)
      printf '\033[1;36mFreezing apps for Android user %s...\033[0m\n\n' "$target_user"
      printf '%s\n' "$selected" | sudo sh -c '
        user=$1
        while IFS= read -r pkg; do
          [ -n "$pkg" ] || continue
          printf "  Freezing %s... " "$pkg"
          pm disable-user --user "$user" "$pkg"
        done
      ' sh "$target_user"
      ;;

    enable)
      printf '\033[1;36mEnabling apps for Android user %s...\033[0m\n\n' "$target_user"
      printf '%s\n' "$selected" | sudo sh -c '
        user=$1
        while IFS= read -r pkg; do
          [ -n "$pkg" ] || continue
          printf "  Enabling %s... " "$pkg"
          pm enable --user "$user" "$pkg"
        done
      ' sh "$target_user"
      ;;

    uninstall)
      printf '\033[1;33mApplications targeted for Android user %s:\033[0m\n\n' "$target_user"

      printf '%s\n' "$selected" | while IFS= read -r pkg; do
        [ -n "$pkg" ] && printf '  \033[1;31m•\033[0m %s\n' "$pkg"
      done

      printf '\nConfirm batch uninstall? (y/N): '
      read -r confirm </dev/tty

      case "$confirm" in
        y|Y)
          printf '\n'
          printf '%s\n' "$selected" | sudo sh -c '
            user=$1
            while IFS= read -r pkg; do
              [ -n "$pkg" ] || continue
              printf "Uninstalling %s...\n" "$pkg"
              pm uninstall --user "$user" "$pkg"
            done
          ' sh "$target_user"

          printf '\n\033[1;32mUninstall operation finished.\033[0m\n'
          ;;

        *)
          printf '\033[1;37mOperation canceled.\033[0m\n'
          ;;
      esac
      ;;
  esac

  printf '\nPress ENTER to return...'
  read -r _ </dev/tty
}

# --------------------------------------------------
# MAIN INTERFACE
# --------------------------------------------------

case "$1" in
  --help)
    show_help
    exit 0
    ;;
esac

while :; do
  profile_name=$(get_profile_name)
  profile_label=$(get_profile_label)

  [ -n "$profile_name" ] || profile_name="Android user $USER_ID"

  case "$FILTER" in
    user) filter_label='User apps' ;;
    system) filter_label='System apps' ;;
    *)
      FILTER=user
      filter_label='User apps'
      ;;
  esac

  # Package queries happen only for the active profile.
  packages=$(list_packages "$USER_ID" "$FILTER")

  if [ -z "$packages" ]; then
    printf '\nNo packages found in %s / %s.\n' \
      "$profile_name" "$filter_label"
    printf 'Press ENTER to return...'
    read -r _ </dev/tty
    continue
  fi

  # Fetch disabled packages once per active profile.
  disabled_packages=$(
    sudo cmd package list packages --user "$USER_ID" -d 2>/dev/null |
      sed 's/^package://'
  )

  display_packages=$(printf '%s\n' "$packages" |
    awk -v disabled="$disabled_packages" '
      BEGIN {
        n = split(disabled, items, "\n")
        for (i = 1; i <= n; i++)
          if (items[i] != "") frozen[items[i]] = 1
      }
      {
        if ($0 in frozen)
          printf "\033[1;36m\033[0m\t%s\n", $0
        else
          printf " \t%s\n", $0
      }
    ')

  : > "$STATE_FILE"

  prompt="📱 ${profile_name} · ${filter_label} > "

  click_bind="click-header:execute-silent(col=\$FZF_CLICK_HEADER_COLUMN; awk -v c=\$col '\$1 <= c && c <= \$2 {print \$3, \$4; exit}' '$TAB_MAP' > '$STATE_FILE')+abort"

  result=$(printf '%s\n' "$display_packages" | fzf \
    --multi \
    --reverse \
    --ansi \
    --delimiter='\t' \
    --disabled \
    --prompt="$prompt" \
    --header="$HEADER" \
    --header-first \
    --preview="'$PREVIEW' '$USER_ID' {2}" \
    --preview-window='bottom:7:wrap' \
    --expect="$EXPECT_KEYS" \
    --bind='space:toggle+down' \
    --bind='u:deselect-all' \
    --bind='tab:ignore,btab:ignore' \
    --bind='ctrl-r:toggle-search+clear-query' \
    --bind="esc:clear-query+disable-search+change-prompt($prompt)" \
    --bind="?:execute('$SELF' --help)" \
    --bind="$click_bind" \
    --bind='ctrl-q:abort')

  fzf_status=$?

  # Header clicks communicate their destination through STATE_FILE.
  if [ -s "$STATE_FILE" ]; then
    read -r target_kind target_value < "$STATE_FILE"
    rm -f "$STATE_FILE"

    case "$target_kind" in
      profile)
        case "$target_value" in
          ''|*[!0-9]*) continue ;;
          *) USER_ID=$target_value ;;
        esac
        ;;
      filter)
        case "$target_value" in
          user|system) FILTER=$target_value ;;
        esac
        ;;
    esac

    continue
  fi

  rm -f "$STATE_FILE"

  # Quit on CTRL-Q / ESC / CTRL-C.
  [ "$fzf_status" -eq 0 ] || break

  key=$(printf '%s\n' "$result" | sed -n '1p')
  selected=$(printf '%s\n' "$result" |
    sed '1d' |
    awk -F '\t' 'NF >= 2 { print $2 }')

  case "$key" in
    alt-u)
      FILTER=user
      ;;

    alt-y)
      FILTER=system
      ;;

    alt-*)
      target_user=$(awk -F '\t' -v key="$key" \
        '$1 == key { print $2; exit }' "$SHORTCUT_FILE")

      case "$target_user" in
        ''|*[!0-9]*) break ;;
        *) USER_ID=$target_user ;;
      esac
      ;;

    ctrl-f)
      run_action freeze "$USER_ID" "$selected"
      ;;

    ctrl-t)
      run_action enable "$USER_ID" "$selected"
      ;;

    enter)
      run_action uninstall "$USER_ID" "$selected"
      ;;

    *)
      break
      ;;
  esac
done

